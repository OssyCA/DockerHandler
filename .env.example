# Controller-API:ets miljövariabler på servern, lästa av docker compose.
# Dubbla understreck = nästlad nyckel. Inget av detta hör i appsettings.json.
# Mobilappen får en egen .env.example under mobile/ i fas 3.

ASPNETCORE_ENVIRONMENT=Production

Docker__Endpoint=unix:///var/run/docker.sock
Docker__ManagedLabelKey=managed-by
Docker__ManagedLabelValue=docker-controller
Docker__DefaultStopTimeoutSeconds=10

# Arrayer indexeras. Controllerns egen container måste ligga här.
Docker__DeniedNames__0=docker-controller

# API-nycklar. Minst en krävs, annars startar inte appen.
# Id är en fri etikett som hamnar i loggen. Value är hemligheten, minst 32 tecken.
# Generera med: openssl rand -hex 32
# Rotation: lägg till Auth__Keys__1__* och starta om, ta bort den gamla efteråt.
Auth__Keys__0__Id=
Auth__Keys__0__Value=
