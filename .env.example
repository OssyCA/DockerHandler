# Environment variables for the controller API on the server, read by docker compose.
# Double underscore = nested key. None of this belongs in appsettings.json.
# The mobile app gets its own .env.example under mobile/ in phase 3.

ASPNETCORE_ENVIRONMENT=Production

DOMAIN=

Docker__Endpoint=tcp://socket-proxy:2375
Docker__ManagedLabelKey=managed-by
Docker__ManagedLabelValue=docker-controller
Docker__DefaultStopTimeoutSeconds=10

# Arrays are indexed. The controller's own container must be listed here.
Docker__DeniedNames__0=docker-controller

# API keys. At least one is required, otherwise the app won't start.
# Id is a free-form label that ends up in the log. Value is the secret, at least 32 characters.
# Generate with: openssl rand -hex 32
# Rotation: add Auth__Keys__1__* and restart, then remove the old one.
Auth__Keys__0__Id=
Auth__Keys__0__Value=
